<section class="guitars-section" id="guitars-section" aria-label="Guitar gallery">
  {% for row in rows %}
    {% set entity = row.content['#row']._entity %}
    {% set guitar_type = entity.field_type.value|default('all')|lower %}
    {% set description = entity.body.summary|default(entity.body.value)|striptags|trim %}
    {% set image_field = entity.field_image %}
    
    <div class="guitar-section" tabindex="0" role="group" data-type="{{ guitar_type }}" data-description="{{ description }}" aria-label="{{ description }}">
      <div class="guitar-section__img-wrap" data-description="{{ description }}">
        {% if image_field and image_field.0 %}
          {% set image_url = file_url(image_field.0.entity.uri.value) %}
          <img src="{{ image_url }}" alt="{{ description }}" width="400" height="533">
        {% else %}
          <img src="" alt="{{ description }}" width="400" height="533">
        {% endif %}
      </div>
    </div>
  {% endfor %}
</section>

<!-- Lightbox -->
<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged image" hidden>
  <button type="button" class="lightbox__close" aria-label="Close">&times;</button>
  <div class="lightbox__inner">
    <img class="lightbox__img" src="" alt="">
    <p class="lightbox__caption"></p>
  </div>
</div>